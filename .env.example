# ============================================================
# 环境配置模板（.env.example）
#
# 用法：
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#   然后编辑 .env 填入真实值。
#
# 安全须知：
#   - 真实密钥只写入 .env；.env 已在 .gitignore 中，**严禁提交**
#   - 本模板（.env.example）只含占位值，是**唯一**入库的配置载体
#   - 优先级：系统环境变量 > .env 文件 > 代码默认值（config/settings.py）
#   - 生产部署：优先用系统环境变量或云密钥服务注入，服务器上不放 .env 文件
#   - 密钥申请：https://dashscope.console.aliyun.com/apiKey （阿里云百炼）
# ============================================================

# ===== LLM（必填）：阿里云百炼 DashScope，OpenAI 兼容接口 =====
MODEL_API_KEY=sk-your-dashscope-api-key-here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# ===== Neo4j 图数据库（docker-compose 默认账号 neo4j / 12345678）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ===== BGE-M3 嵌入模型本地路径（相对项目根目录或绝对路径；禁联网回退）=====
EMBEDDING_MODEL_PATH=./models/bge-m3

# ===== 对话历史存储（Redis 热缓存 + MySQL 冷存储，docker-compose 一并拉起）=====
REDIS_URL=redis://localhost:6379/0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=ccr_history

# ===== 用户认证与数据隔离（§6.4，默认开启）=====
# AUTH_ENABLED=false 时所有接口不做鉴权（仅限本地联调/评测；生产必须保持 true）
# JWT_SECRET_KEY 生产环境必须替换为强随机值，严禁使用默认值/占位值
AUTH_ENABLED=true
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ===== 日志级别：DEBUG / INFO / WARNING / ERROR =====
LOG_LEVEL=INFO

# ===== 抽取微调模型（可选）：想让实体/关系抽取走自部署 vLLM 微调模型时才填 =====
# 切换只需改 EXTRACTION_MODEL_BASE_URL：留空=抽取回退主 LLM（全云端）；填入=仅抽取走本地微调模型
# EXTRACTION_MODEL_BASE_URL=http://<GPU服务器IP>:8000/v1
# EXTRACTION_MODEL_API_KEY=EMPTY
# EXTRACTION_MODEL_NAME=qwen2.5-merged    # 需与 vLLM 启动时的 --served-model-name 一致

# ===== A2A 对外协作端点（默认开启）=====
# 把本系统作为一个可被发现、可被委托的远端 Agent 暴露出去：
#   Agent Card  GET  /.well-known/agent-card.json   （五项 skill 的能力说明书）
#   JSON-RPC    POST /a2a                            （主传输绑定）
#   REST        POST /a2a/message:send               （给不方便发 JSON-RPC 的调用方）
# 与 MCP 是两条正交链路：MCP 是本系统出去「用工具」，A2A 是外部系统进来「用本系统」。
# 缺 a2a-sdk 时只打印告警并跳过挂载，不影响主服务启动。
A2A_ENABLED=true                    # 关闭后主服务行为与改造前完全一致，便于灰度与回滚
# ⚠️ 值必须独占一行：空值 + 行内注释会让 dotenv 把注释当成值（实测踩坑）
A2A_PUBLIC_URL=
                                    # 留空=按 API_PORT 推断为 http://127.0.0.1:{API_PORT}（仅本机联调可用）
                                    # ⚠️ 部署到服务器时必须显式配置，否则外部系统拿到的回调地址是错的

# ===== 可选调优项（保持注释 = 使用代码默认值）=====
# APP_NAME=CorporateComplianceReviewAgent  # 应用名
# API_PORT=8000                       # FastAPI 端口
# MAX_CONCURRENCY=5                   # 并发闸门上限（防止并发打满上游 LLM API）
# REQUEST_TIMEOUT=60                  # 单次审查请求超时（秒）
# LLM_ENABLE_THINKING=false           # qwen3 思考(reasoning)模式：默认关(快)，复杂合规推理可设 true
# LLM_MAX_RETRIES=1                   # LLM 失败重试次数：延迟敏感建议 ≤1
# ENABLE_REACT_LAYER=true             # 法规知识分支是否启用可选 ReAct 多跳层
# RETRIEVAL_RECALL_THRESHOLD=0.5      # 向量召回阈值（召回档：宁多勿漏，越低越宽）
# ENTITY_LINK_THRESHOLD=0.85          # 实体链接阈值（链接档：宁缺毋滥，越高越严格）
# ENTITY_LINK_TOP_K=3                 # 实体链接每词考察候选数
# TEXT2CYPHER_ENABLED=true            # 是否为 ReAct 层提供 Text2Cypher 工具
# TEXT2CYPHER_MAX_RECORDS=50          # Text2Cypher 单次查询返回记录上限

# ===== 工具层传输方式（inproc / mcp）=====
# inproc（默认）：进程内直调 LangChain @tool，零跨进程开销，评测与生产问答走这条
# mcp          ：经独立进程 MCP server 调用（stdio），用于工具层跨进程/跨系统复用
#   注意：stdio 模式下每个工具调用会新建会话（重新拉起子进程），比 inproc 慢，
#         适合架构验证与外部消费方接入，不建议用来跑全量评测（会污染基线耗时）
# TOOL_TRANSPORT=inproc
# MCP_SERVER_COMMAND=python
# MCP_SERVER_ARGS=-m,mcp_server.server     # 逗号分隔（不是空格）
# MCP_SERVER_CWD=                          # 留空=项目根
